{
  "name": "genuivo_api",
  "version": "1.0.29",
  "private": true,
  "description": "Starter API - Hono backend with PostgreSQL + Drizzle ORM",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run src/index.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src/",
    "lint:fix": "bunx eslint src/ --fix",
    "format": "bunx prettier --write \"src/**/*.ts\"",
    "format:check": "bunx prettier --check \"src/**/*.ts\"",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@sudobility/auth_service": "^1.1.30",
    "@sudobility/genuivo_types": "^0.0.20",
    "@sudobility/types": "^1.9.76",
    "drizzle-orm": "~0.45.4",
    "firebase-admin": "~13.10.0",
    "hono": "~4.11.5",
    "postgres": "~3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@sudobility/test-db-guard": "^1.0.3",
    "@types/node": "~24.19.2",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "globals": "~16.5.0",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/sudobility-usf/starter_api.git"
  }
}
